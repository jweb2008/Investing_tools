# Copy to .env and fill in. Never commit the real .env.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=schwab_token.json

# schwab or yahoo
DATA_SOURCE=schwab

# Scanner filters (optional)
SCAN_MIN_DOLLAR_VOLUME=20000000
# Skip stocks above this price. Blank = no limit.
SCAN_MAX_PRICE=

# Trade feed (optional, defaults shown)
SYNC_START=2026-01-01
TRACKER_DIR=
TRACKER_PREFIX=2025-26_Trading_Tracker_
TRACKER_TABLE=Table14
TRADE_LOG_PATH=
# last 4 of each account = tracker name, e.g. 1234=Roth,5678=Joint
ACCOUNT_NAMES=
BACKUP_DIR=
BACKUP_KEEP_WEEKS=12
